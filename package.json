{
  "name": "code-blur",
  "displayName": "Code Blur",
  "description": "Apply blur effects to selected code sections for focused learning",
  "version": "1.0.0",
  "publisher": "code-blur",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "codeBlur.applyBlur",
        "title": "Apply Blur Effect"
      },
      {
        "command": "codeBlur.removeBlur",
        "title": "Remove Blur Effect"
      },
      {
        "command": "codeBlur.increaseBlur",
        "title": "Increase Blur Intensity"
      },
      {
        "command": "codeBlur.decreaseBlur",
        "title": "Decrease Blur Intensity"
      },
      {
        "command": "codeBlur.clearAllBlur",
        "title": "Clear All Blur Effects"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "codeBlur.applyBlur",
          "group": "codeBlur"
        },
        {
          "when": "editorHasSelection",
          "command": "codeBlur.removeBlur",
          "group": "codeBlur"
        },
        {
          "when": "editorHasSelection",
          "command": "codeBlur.increaseBlur",
          "group": "codeBlur"
        },
        {
          "when": "editorHasSelection",
          "command": "codeBlur.decreaseBlur",
          "group": "codeBlur"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-blur-sidebar",
          "title": "Code Blur",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "code-blur-sidebar": [
        {
          "id": "codeBlurControls",
          "name": "Blur Controls",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^14.17.0",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "eslint": "^7.27.0",
    "typescript": "^4.3.2",
    "vsce": "^1.100.0"
  },
  "license": "MIT"
}
